+/*
+ * Vencord, a Discord client mod
+ * Copyright (c) 2024 Vendicated and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Modified 2026-07-24 by SeaL773: add deterministic, bounded pagination for
+// user-triggered historical Bridge collection.
+
+export const DEFAULT_BACKFILL_COUNT = 100;
+export const MIN_BACKFILL_COUNT = 1;
+export const MAX_BACKFILL_COUNT = 5000;
+export const MAX_BACKFILL_PAGE_SIZE = 100;
+
+export interface BackfillPageRequest {
+    limit: number;
+    before?: string;
+}
+
+export interface BackfillPaginationResult<T> {
+    entries: T[];
+    examined: number;
+    historyEnded: boolean;
+}
+
+export function validateBackfillCount(value: unknown): number {
+    if (typeof value !== "number" || !Number.isInteger(value) || value < MIN_BACKFILL_COUNT || value > MAX_BACKFILL_COUNT)
+        throw new Error(`count must be an integer from ${MIN_BACKFILL_COUNT} to ${MAX_BACKFILL_COUNT}`);
+
+    return value;
+}
+
+function readMessageId(value: unknown): string {
+    if (typeof value !== "object" || value === null || !("id" in value))
+        throw new Error("history entry is missing an id");
+
+    const { id } = value;
+    if (typeof id !== "string" || !/^\d+$/.test(id))
+        throw new Error("history entry has a malformed id");
+
+    return id;
+}
+
+export async function paginateBackfill<T>(
+    requestedCount: number,
+    fetchPage: (request: BackfillPageRequest) => Promise<readonly T[]>,
+    afterPage?: () => void
+): Promise<BackfillPaginationResult<T>> {
+    const count = validateBackfillCount(requestedCount);
+    const entries: T[] = [];
+    const seenIds = new Set<string>();
+    const seenCursors = new Set<string>();
+    let examined = 0;
+    let before: string | undefined;
+    let historyEnded = false;
+
+    while (examined < count) {
+        const limit = Math.min(MAX_BACKFILL_PAGE_SIZE, count - examined);
+        const rawPage = await fetchPage(before == null ? { limit } : { limit, before });
+        if (!Array.isArray(rawPage))
+            throw new Error("history response body must be an array");
+        if (rawPage.length > limit)
+            throw new Error("history response exceeded the requested page limit");
+
+        const page = rawPage.slice();
+        examined += page.length;
+
+        if (page.length === 0) {
+            historyEnded = true;
+            afterPage?.();
+            break;
+        }
+
+        for (const entry of page) {
+            const id = readMessageId(entry);
+            if (!seenIds.has(id)) {
+                seenIds.add(id);
+                entries.push(entry);
+            }
+        }
+
+        const nextBefore = readMessageId(page[page.length - 1]);
+        if (seenCursors.has(nextBefore) || (before != null && BigInt(nextBefore) >= BigInt(before)))
+            throw new Error("history cursor did not advance");
+
+        seenCursors.add(nextBefore);
+        before = nextBefore;
+        historyEnded = page.length < limit;
+        afterPage?.();
+        if (historyEnded)
+            break;
+    }
+
+    return { entries, examined, historyEnded };
+}
