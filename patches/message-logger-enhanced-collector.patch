+/*
+ * Vencord, a Discord client mod
+ * Copyright (c) 2024 Vendicated and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Modified 2026-07-24 by SeaL773: coordinate all lifecycle persistence by
+// message ID and provide retryable CREATED journal commits.
+
+export type CreatedCommitOutcome = "journaled" | "already-journaled" | "interrupted";
+
+export interface CreatedCommitOperations {
+    messageId: string;
+    canAppend: () => boolean;
+    hasCreatedEvent: () => Promise<boolean>;
+    appendCreated: () => Promise<void>;
+    markCreatedEvent: () => Promise<void>;
+    storeUnmarked?: () => Promise<void>;
+    storeWhenCannotAppend?: boolean;
+}
+
+export interface MessagePersistenceCoordinator {
+    runExclusive<T>(messageId: string, operation: () => Promise<T>): Promise<T>;
+    commitCreated(operations: CreatedCommitOperations): Promise<CreatedCommitOutcome>;
+}
+
+export function preserveCreatedJournalMarker<T extends object>(
+    existing: { created_journaled?: true; } | undefined,
+    replacement: T
+): T & { created_journaled?: true; } {
+    return existing?.created_journaled === true
+        ? { ...replacement, created_journaled: true }
+        : replacement;
+}
+
+export function createMessagePersistenceCoordinator(): MessagePersistenceCoordinator {
+    const locks = new Map<string, Promise<void>>();
+
+    async function runExclusive<T>(messageId: string, operation: () => Promise<T>): Promise<T> {
+        const previous = locks.get(messageId) ?? Promise.resolve();
+        let release = () => { };
+        const current = new Promise<void>(resolve => {
+            release = resolve;
+        });
+        locks.set(messageId, current);
+
+        await previous;
+        try {
+            return await operation();
+        } finally {
+            release();
+            if (locks.get(messageId) === current)
+                locks.delete(messageId);
+        }
+    }
+
+    async function commitCreated(operations: CreatedCommitOperations): Promise<CreatedCommitOutcome> {
+        return runExclusive(operations.messageId, async () => {
+            if (await operations.hasCreatedEvent())
+                return "already-journaled";
+
+            if (!operations.canAppend()) {
+                if (operations.storeWhenCannotAppend)
+                    await operations.storeUnmarked?.();
+                return "interrupted";
+            }
+
+            try {
+                await operations.appendCreated();
+            } catch (error) {
+                await operations.storeUnmarked?.();
+                throw error;
+            }
+
+            await operations.markCreatedEvent();
+            return "journaled";
+        });
+    }
+
+    return { runExclusive, commitCreated };
+}
