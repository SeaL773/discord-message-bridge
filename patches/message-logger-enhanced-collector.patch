@@ -0,0 +1,189 @@
+/*
+ * Vencord, a Discord client mod
+ * Copyright (c) 2024 Vendicated and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Modified 2026-07-20 by SeaL773: add a validated, privacy-preserving
+// channel catalog scope that acts as the mandatory NDJSON allowlist.
+
+import { ChannelType } from "@vencord/discord-types/enums";
+import { ChannelStore, GuildChannelStore, GuildStore } from "@webpack/common";
+
+import { Flogger, Native } from ".";
+import { ChannelCatalogEntry, ChannelCatalogRequest, ChannelCatalogResult } from "./types";
+
+const RETRY_DELAYS = [0, 1000, 3000] as const;
+const NAME_MAX_LENGTH = 256;
+const GUILD_TEXT_CHANNEL_TYPES = new Set<ChannelType>([
+    ChannelType.GUILD_TEXT,
+    ChannelType.GUILD_ANNOUNCEMENT,
+    ChannelType.GUILD_FORUM,
+    ChannelType.GUILD_MEDIA
+]);
+
+interface ActiveChannelCatalogScope {
+    guildId: string;
+    channelIds: Set<string>;
+}
+
+export interface RequestedEventNames {
+    channel_name?: string;
+    guild_name?: string;
+}
+
+let activeScope: ActiveChannelCatalogScope | null = null;
+let refreshPromise: Promise<void> | null = null;
+
+function sleep(delay: number) {
+    return new Promise<void>(resolve => setTimeout(resolve, delay));
+}
+
+function sanitizeName(value: unknown): string | undefined {
+    if (typeof value !== "string" || value.length > NAME_MAX_LENGTH || /[\u0000-\u001f\u007f]/.test(value))
+        return undefined;
+
+    const name = value.trim();
+    return name.length > 0 ? name : undefined;
+}
+
+function getParentName(parentId: string | null | undefined, guildId: string) {
+    if (parentId == null)
+        return undefined;
+
+    const parent = ChannelStore.getChannel(parentId);
+    if (parent?.guild_id !== guildId || parent.type !== ChannelType.GUILD_CATEGORY)
+        return undefined;
+
+    return sanitizeName(parent.name);
+}
+
+function resolveSelectedChannels(request: Extract<ChannelCatalogRequest, { mode: "selected_channels"; }>) {
+    const channels: ChannelCatalogEntry[] = request.channel_ids.map(id => {
+        const channel = ChannelStore.getChannel(id);
+        if (channel == null)
+            return { id, status: "not_found" };
+        if (channel.guild_id !== request.guild_id)
+            return { id, status: "guild_mismatch" };
+
+        const name = sanitizeName(channel.name);
+        const parentName = getParentName(channel.parent_id, request.guild_id);
+        return {
+            id,
+            ...(name ? { name } : {}),
+            type: channel.type,
+            ...(parentName ? { parent_name: parentName } : {}),
+            status: "ok"
+        };
+    });
+
+    return channels;
+}
+
+function resolveGuildTextChannels(request: Extract<ChannelCatalogRequest, { mode: "guild_text_channels"; }>) {
+    const seenChannelIds = new Set<string>();
+    const channels: ChannelCatalogEntry[] = [];
+
+    for (const { channel } of GuildChannelStore.getChannels(request.guild_id).SELECTABLE) {
+        if (channel.guild_id !== request.guild_id || !GUILD_TEXT_CHANNEL_TYPES.has(channel.type) || seenChannelIds.has(channel.id))
+            continue;
+
+        const name = sanitizeName(channel.name);
+        if (name == null)
+            continue;
+
+        seenChannelIds.add(channel.id);
+        const parentName = getParentName(channel.parent_id, request.guild_id);
+        channels.push({
+            id: channel.id,
+            name,
+            type: channel.type,
+            ...(parentName ? { parent_name: parentName } : {}),
+            status: "ok"
+        });
+    }
+
+    return channels;
+}
+
+function resolveCatalog(request: ChannelCatalogRequest): ChannelCatalogResult {
+    const guild = GuildStore.getGuild(request.guild_id);
+    const channels = request.mode === "selected_channels"
+        ? resolveSelectedChannels(request)
+        : resolveGuildTextChannels(request);
+
+    const guildName = sanitizeName(guild?.name);
+    return {
+        schema_version: 1,
+        request_id: request.request_id,
+        generated_at: new Date().toISOString(),
+        guild: {
+            id: request.guild_id,
+            ...(guildName ? { name: guildName } : {})
+        },
+        channels
+    };
+}
+
+function isComplete(request: ChannelCatalogRequest, result: ChannelCatalogResult) {
+    if (result.guild.name == null)
+        return false;
+
+    return request.mode === "selected_channels"
+        ? result.channels.every(channel => channel.status !== "not_found")
+        : true;
+}
+
+async function runRefresh() {
+    const request = await Native.readChannelCatalogRequest();
+    if (request == null) {
+        activeScope = null;
+        return;
+    }
+
+    let result = resolveCatalog(request);
+    for (const delay of RETRY_DELAYS.slice(1)) {
+        if (isComplete(request, result))
+            break;
+        await sleep(delay);
+        result = resolveCatalog(request);
+    }
+
+    await Native.writeChannelCatalogResult(result);
+    activeScope = {
+        guildId: request.guild_id,
+        channelIds: new Set(result.channels.filter(channel => channel.status === "ok").map(channel => channel.id))
+    };
+}
+
+export function refreshChannelCatalog() {
+    if (refreshPromise != null)
+        return refreshPromise;
+
+    activeScope = null;
+    refreshPromise = runRefresh()
+        .catch(() => {
+            Flogger.error("Failed to refresh channel catalog", { code: "channel_catalog_refresh_failed" });
+        })
+        .finally(() => {
+            refreshPromise = null;
+        });
+    return refreshPromise;
+}
+
+export function getRequestedEventNames(channelId: string): RequestedEventNames | null {
+    const scope = activeScope;
+    if (scope == null || !scope.channelIds.has(channelId))
+        return null;
+
+    const channel = ChannelStore.getChannel(channelId);
+    if (channel?.guild_id !== scope.guildId)
+        return null;
+
+    const channelName = sanitizeName(channel.name);
+    const guildName = sanitizeName(GuildStore.getGuild(scope.guildId)?.name);
+    return {
+        ...(channelName ? { channel_name: channelName } : {}),
+        ...(guildName ? { guild_name: guildName } : {})
+    };
+}
