+/*
+ * Vencord, a Discord client mod
+ * Copyright (c) 2024 Vendicated and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Modified 2026-07-24 by SeaL773: share safe local feedback mapping between
+// context-menu and slash-command historical backfill triggers.
+
+export interface BackfillExecutionResult {
+    ok: boolean;
+    message: string;
+}
+
+const SAFE_BACKFILL_FAILURES = new Set([
+    "MessageLoggerEnhanced is stopping or not started.",
+    "Enable created-message persistence before running backfill.",
+    "This channel is not in the active Bridge channel-catalog allowlist.",
+    "A backfill is already running for this channel.",
+    "count must be an integer from 1 to 5000"
+]);
+
+export async function runBackfillExecution(
+    channelId: string,
+    requestedCount: unknown,
+    validateCount: (value: unknown) => number,
+    execute: (targetChannelId: string, count: number) => Promise<string>,
+    logError: (code: "backfill_failed") => void
+): Promise<BackfillExecutionResult> {
+    try {
+        const count = validateCount(requestedCount);
+        return { ok: true, message: await execute(channelId, count) };
+    } catch (error) {
+        logError("backfill_failed");
+        const safeDetail = error instanceof Error && SAFE_BACKFILL_FAILURES.has(error.message)
+            ? ` ${error.message}`
+            : "";
+        return { ok: false, message: `Backfill failed.${safeDetail}` };
+    }
+}
