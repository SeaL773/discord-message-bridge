+    setFiniteNumber(component, "type", value.type);
+    setFiniteNumber(component, "id", value.id);
+    setFiniteNumber(component, "style", value.style);
+    setFiniteNumber(component, "accent_color", value.accentColor, value.accent_color);
+    setFiniteNumber(component, "min_values", value.minValues, value.min_values);
+    setFiniteNumber(component, "max_values", value.maxValues, value.max_values);
+    setComponentString(context, component, "content", MAX_TEXT_LENGTH, value.content);
+    setComponentString(context, component, "label", MAX_TEXT_LENGTH, value.label);
+    setComponentString(context, component, "description", MAX_TEXT_LENGTH, value.description);
+    setComponentString(context, component, "placeholder", MAX_TEXT_LENGTH, value.placeholder);
+    setComponentString(context, component, "url", MAX_URL_LENGTH, value.url);
