+/*
+ * Vencord, a Discord client mod
+ * Copyright (c) 2024 Vendicated and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Modified 2026-07-20 by SeaL773: provide failure-independent clearing of
+// IndexedDB logs and Bridge integration journals for both Clear All UIs.
+
+export type ClearLocalLogsOperation = () => Promise<void>;
+
+export async function clearAllLocalLogs(
+    clearIndexedDB: ClearLocalLogsOperation,
+    clearIntegrationLogs: ClearLocalLogsOperation
+) {
+    const results = await Promise.allSettled([
+        Promise.resolve().then(clearIndexedDB),
+        Promise.resolve().then(clearIntegrationLogs)
+    ]);
+    const errors = results
+        .filter((result): result is PromiseRejectedResult => result.status === "rejected")
+        .map(result => result.reason as unknown);
+
+    if (errors.length > 0)
+        throw new AggregateError(errors, "Failed to clear all local logs");
+}
