+
+function normalizeEmoji(value: unknown) {
+    if (!isRecord(value)) return;
+    const emoji: Record<string, unknown> = {};
+    setBoundedString(emoji, "id", MAX_TEXT_LENGTH, value.id);
+    setBoundedString(emoji, "name", MAX_TEXT_LENGTH, value.name);
+    setBoolean(emoji, "animated", value.animated);
+    return Object.keys(emoji).length ? emoji : undefined;
