+/*
+ * Vencord, a Discord client mod
+ * Copyright (c) 2024 Vendicated and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Modified 2026-07-24 by SeaL773: permanently invalidate historical backfills
+// across plugin stop/start boundaries while allowing safe restart.
+
+export interface BackfillLease {
+    channelId: string;
+    generation: number;
+    token: symbol;
+}
+
+export function createBackfillLifecycle() {
+    const active = new Map<string, symbol>();
+    let generation = 0;
+    let started = false;
+
+    return {
+        start() {
+            generation++;
+            started = true;
+        },
+
+        stop() {
+            generation++;
+            started = false;
+            active.clear();
+        },
+
+        begin(channelId: string): BackfillLease {
+            if (!started)
+                throw new Error("MessageLoggerEnhanced is stopping or not started.");
+            if (active.has(channelId))
+                throw new Error("A backfill is already running for this channel.");
+
+            const token = Symbol(channelId);
+            active.set(channelId, token);
+            return { channelId, generation, token };
+        },
+
+        isCurrent(lease: BackfillLease) {
+            return started
+                && lease.generation === generation
+                && active.get(lease.channelId) === lease.token;
+        },
+
+        finish(lease: BackfillLease) {
+            if (active.get(lease.channelId) === lease.token)
+                active.delete(lease.channelId);
+        }
+    };
+}
