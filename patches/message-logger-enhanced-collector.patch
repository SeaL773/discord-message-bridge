+    if (emoji) component.emoji = emoji;
+    const media = normalizeMediaReference(value.media, context);
+    if (media) component.media = media;
+    const thumbnail = normalizeMediaReference(value.thumbnail, context);
+    if (thumbnail) component.thumbnail = thumbnail;
+    const file = normalizeMediaReference(value.file, context);
+    if (file) component.file = file;
