+/*
+ * Vencord, a Discord client mod
+ * Copyright (c) 2024 Vendicated and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Modified 2026-07-24 by SeaL773: enforce the created-message privacy gate and
+// normalize a complete historical batch before persistence can begin.
+
+export interface FetchedBackfillBatch<T> {
+    entries: readonly T[];
+    examined: number;
+    historyEnded: boolean;
+}
+
+export interface PreparedBackfillEntry<T> {
+    message: T;
+    capturedAt: string;
+}
+
+export interface PreparedBackfillBatch<T> {
+    entries: PreparedBackfillEntry<T>[];
+    examined: number;
+    unique: number;
+    ignored: number;
+    historyEnded: boolean;
+}
+
+export async function fetchAndPrepareBackfill<TRaw, TClean>(
+    persistCreatedMessages: boolean,
+    fetchBatch: () => Promise<FetchedBackfillBatch<TRaw>>,
+    normalize: (raw: TRaw) => TClean,
+    getTimestamp: (raw: TRaw) => string,
+    shouldIgnore: (message: TClean) => boolean
+): Promise<PreparedBackfillBatch<TClean>> {
+    if (!persistCreatedMessages)
+        throw new Error("Created-message persistence must be enabled before backfill.");
+
+    const fetched = await fetchBatch();
+    const normalized = fetched.entries.map(raw => ({
+        message: normalize(raw),
+        capturedAt: getTimestamp(raw)
+    }));
+    const entries = normalized.filter(entry => !shouldIgnore(entry.message));
+
+    return {
+        entries,
+        examined: fetched.examined,
+        unique: fetched.entries.length,
+        ignored: normalized.length - entries.length,
+        historyEnded: fetched.historyEnded
+    };
+}
