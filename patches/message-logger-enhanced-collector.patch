+    setComponentString(context, media, "proxy_url", MAX_URL_LENGTH, value.proxyURL, value.proxy_url);
+    setComponentString(context, media, "content_type", MAX_TEXT_LENGTH, value.contentType, value.content_type);
+    setComponentString(context, media, "placeholder", MAX_TEXT_LENGTH, value.placeholder);
