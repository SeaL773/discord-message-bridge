+    }
+    if (Array.isArray(value.stickers)) {
+        const stickers = value.stickers.slice(0, MAX_STICKERS).flatMap(sticker => {
+            const normalized = normalizeSticker(sticker);
+            return normalized ? [normalized] : [];
+        });
+        if (stickers.length) message.stickers = stickers;
+    }
