+    return Object.keys(poll).length ? poll : undefined;
+}
+
+function normalizeSnapshotMessage(value: unknown, context: CleanupContext) {
+    if (!isRecord(value)) return;
+    const message: Record<string, unknown> = {};
+    setBoundedString(message, "content", MAX_CONTENT_LENGTH, value.content);
+    const embeds = normalizeEmbeds(value.embeds);
+    if (embeds.length) message.embeds = embeds;
+    const components = normalizeComponents(value.components, context);
+    if (components?.length) message.components = components;
+    if (Array.isArray(value.attachments)) {
